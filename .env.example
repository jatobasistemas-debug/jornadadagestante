# Copy to .env.local. Never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_URL=http://localhost:3000
# Server-only for demo provisioning and reauthenticated account deletion. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Enable registration after reviewing and publishing the supplied draft terms.
REGISTRATION_ENABLED=false
# Required ONLY for the demo seed, use synthetic data and an isolated project.
ALLOW_DEMO_SEED=false
DEMO_PASSWORD=
