{
  "name": "jornada-da-gestante",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --env-file-if-exists=.env.local --import tsx --test --test-concurrency=1 --test-reporter=tap tests/integration/*.test.ts",
    "seed:demo": "node --env-file=.env.local --import tsx scripts/seed-demo.ts",
    "test:http": "node --env-file=.env.local scripts/test-http.mjs"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@supabase/ssr": "0.8.0",
    "@supabase/supabase-js": "2.115.0",
    "zod": "^4.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/postcss": "^4.1.0",
    "tsx": "^4.21.0",
    "@electric-sql/pglite": "^0.3.15"
  },
  "engines": {
    "node": ">=22"
  }
}
